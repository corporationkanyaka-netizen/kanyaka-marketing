# Copy to .env.development and fill in. Used by `npm run dev` and the db:* scripts.
# Local PostgreSQL (e.g. installed with pgAdmin). Create an empty database named "kanyaka" first.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kanyaka?schema=public"

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=""
IP_HASH_SALT=""

# WhatsApp delivery via UltraMsg (optional). Empty = chat widget falls back to opening wa.me.
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Sales WhatsApp that receives website chats (country code + number, digits only)
WHATSAPP_NOTIFY_TO="919030044304"

# ── Email alerts for new quote requests ──────────────────────────────
# Option A (quickest): Gmail. SMTP_USER = the Gmail address, SMTP_PASS = a 16-character
#   App Password (Google Account → Security → 2-Step Verification → App passwords).
# Option B: Resend (https://resend.com). RESEND_API_KEY + MAIL_FROM on a domain verified in Resend.
# Leave all empty to disable (enquiries are still saved).
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
MAIL_FROM=""
# Who receives the alerts (comma-separated). Empty = subrahmanyam549@gmail.com, kanyaka_corp@hotmail.com
QUOTE_ALERT_TO=""

# Public website address (logo + links in emails)
SITE_URL="https://kanyaka-marketing.vercel.app"
