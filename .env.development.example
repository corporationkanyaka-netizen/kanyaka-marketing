# Copy to .env.development and fill in. Used by `npm run dev` and the db:* scripts.
# Local PostgreSQL (e.g. installed with pgAdmin). Create an empty database named "kanyaka" first.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kanyaka?schema=public"

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=""
IP_HASH_SALT=""

# WhatsApp delivery via UltraMsg (optional). Empty = chat widget falls back to opening wa.me.
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Sales WhatsApp that receives website chats (country code + number, digits only)
WHATSAPP_NOTIFY_TO="919030044304"
