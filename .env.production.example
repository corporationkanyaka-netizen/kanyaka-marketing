# Copy to .env.production (or set these in your hosting dashboard).
# Used by `next build` / `next start` and the db:*:prod scripts.
DATABASE_URL="postgresql://USER:PASSWORD@PROD_HOST:5432/kanyaka?schema=public&sslmode=require"

# Use DIFFERENT random values from development.
ADMIN_API_TOKEN=""
IP_HASH_SALT=""

# WhatsApp delivery via UltraMsg (optional). Empty = chat widget falls back to opening wa.me.
ULTRAMSG_INSTANCE_ID=""
ULTRAMSG_TOKEN=""
# Sales WhatsApp that receives website chats (country code + number, digits only)
WHATSAPP_NOTIFY_TO="919030044304"
